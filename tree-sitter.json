    "authors": [
      {
        "name": "Edmund Miller",
        "email": "edmund@nf-co.re",
        "url": "https://edmundmiller.dev/"
      },
      {
        "name": "Ben Sherman",
        "email": "bentshermann@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/nextflow-io/tree-sitter-nextflow"
